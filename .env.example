# ============================================================================
# SQPAS — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
#
# For local development, only SECRET_KEY and ENCRYPTION_KEY are required.
# For AWS deployment, all production values must be configured.
# ============================================================================

# ---------------------------------------------------------------------------
# Flask Core
# ---------------------------------------------------------------------------
FLASK_APP=wsgi.py
FLASK_ENV=development
# Options: development, testing, staging, production

# Secret key for Flask sessions and CSRF protection.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (SQLite — default if DATABASE_URL is not set):
#   No configuration needed; SQLite is used automatically.
#
# AWS Production (PostgreSQL RDS):
#   DATABASE_URL=postgresql://sqpas_user:STRONG_PASSWORD@your-rds-endpoint.amazonaws.com:5432/sqpas_db
DATABASE_URL=

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# AES-256 encryption key (32 bytes = 64 hex characters).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Losing this key means ALL encrypted question papers are unrecoverable.
ENCRYPTION_KEY=change-me-generate-a-real-encryption-key

# ---------------------------------------------------------------------------
# AWS Configuration (Production only)
# ---------------------------------------------------------------------------
# AWS region for KMS, CloudWatch, and other services
AWS_REGION=ap-south-1

# AWS KMS Key ID or ARN (optional — enables envelope encryption)
# If set, the app uses KMS to decrypt the data encryption key at startup.
# Leave empty to use the plaintext ENCRYPTION_KEY above.
KMS_KEY_ID=

# Base64-encoded encrypted data key (used with KMS envelope encryption)
# Generated via: aws kms generate-data-key --key-id <KMS_KEY_ID> --key-spec AES_256
ENCRYPTED_DATA_KEY=

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
# Timezone for release scheduling (IANA timezone name)
APP_TIMEZONE=Asia/Kolkata

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to 'true' when running behind Nginx reverse proxy
BEHIND_PROXY=false

# Gunicorn port (default: 8000)
PORT=8000

# Number of Gunicorn workers (default: auto-calculated)
# WEB_CONCURRENCY=4
